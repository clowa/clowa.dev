# clowa.dev — the Astro static site.
#
# Bound to :80 (no host filter) so it is the DEFAULT handler: it answers
# clowa.dev, the raw Scaleway-generated URL, the TCP health check and local
# `curl localhost` alike. The redirect hosts under redirects/ use explicit
# `http://<host>` addresses, which are more specific and therefore win over
# this catch-all for their host.
:80 {
	tracing {
		span {http.request.method}
	}

	root * /srv/clowa.dev

	# Astro writes all bundled assets (JS, CSS, fonts, images) into _astro/ with
	# content-hashed filenames. These never change for a given content hash, so
	# they are safe to cache indefinitely in the browser.
	@hashed_assets path /_astro/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	# HTML pages must always be revalidated so visitors see the latest content.
	# Caddy's automatic ETags turn revalidation into a lightweight 304 response
	# (headers only, no body) when the page has not changed — important for
	# reducing the impact of cold starts on returning visitors.
	@html path *.html /
	header @html Cache-Control "no-cache"

	# Sitemaps, manifests, robots.txt: content changes infrequently, short TTL.
	@metadata path *.xml *.txt *.webmanifest
	header @metadata Cache-Control "public, max-age=3600"

	# --- Path redirects (examples, disabled) ---------------------------------
	# Same-host path redirects belong with the site they redirect within. Add
	# `redir` rules here and they take effect before file_server. Example:
	#   redir /about-us /about permanent      # 301 /about-us -> /about
	#   redir /pages/* /blog{uri} permanent		# 301 keep the sub-path

	# Serve pre-compressed sidecar files (.br, .gz) generated at build time.
	# Removes all runtime CPU cost for compression. Falls back to the uncompressed
	# original for clients that do not advertise a supported encoding.
	file_server {
		precompressed br zstd gzip
	}

	handle_errors {
		rewrite * /404.html
		file_server {
			precompressed br zstd gzip
		}
	}
}
