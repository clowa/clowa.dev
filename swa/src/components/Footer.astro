---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faUserSecret, faLeaf } from '@fortawesome/free-solid-svg-icons';

interface Props {
	text: string;
}

const { text } = Astro.props;

---

<footer>
  <p>{text}</p>
  <ul>
    <li>
      <a href="/privacy">
        Privacy Statement
        <i class='fa-1x' set:html={icon(faUserSecret).html}></i>
      </a>
    </li>
    <li>
      <a href="https://www.websitecarbon.com/website/clowa-dev/" target="_blank">
        Carbon Score
        <i class='fa-1x' set:html={icon(faLeaf).html}></i>
      </a>
    </li>
  </ul>
  
</footer>

<style>
  footer {
    text-align: center;
    padding: 1rem;
    color: rgb(var(--accent-light));
    font-size: 0.9rem;
  }

  footer ul {
    list-style: none;
    padding: 0;
    display: grid;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  a i {
    margin-left: 0.25rem;
  }

  /* Unvisited (unclicked) link */
  a:link {
    color: rgb(var(--accent-light));
    text-decoration: none;
  }

  /* Visited (opened/clicked) link */
  a:visited {
    text-decoration:line-through;
    color: rgb(var(--accent-light));
  }

  /* Hover state */
  a:hover {
    font-weight: bold;
  }

  /* Active state (while clicking) */
  a:active {}
</style>
